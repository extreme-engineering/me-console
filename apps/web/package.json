{
  "name": "@meos/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:extension": "tsc && vite build && node -e \"const fs=require('fs');const path='dist';const ext='extension-dist';fs.mkdirSync(ext,{recursive:true});fs.cpSync(path+'/',ext+'/',{recursive:true});\"",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@meos/shared": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.104.0",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.6.5",
    "date-fns": "^3.0.6",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.21.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.42",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.16",
    "esbuild": "0.21.5",
    "jsdom": "^29.1.1",
    "object-hash": "^3.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vitest": "^1.1.3"
  }
}
